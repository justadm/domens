MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=300
MONITOR_TLDS=.com,.io,.ai,.ru
MONITOR_SEED_WORDS=agent,cloud,data,stack,flow,grid,lab,core
MONITOR_ALERT_MIN_SCORE=70
MONITOR_ALERT_STATUSES=available,pending_delete
MONITOR_REQUIRE_PROVIDER_CHECK=true
MONITOR_ALERT_COOLDOWN_MINUTES=180
MONITOR_ALERT_PER_TARGET_RUN_LIMIT=5
MONITOR_ALERT_PER_TARGET_DAILY_LIMIT=25
MONITOR_ALERT_GLOBAL_RUN_LIMIT=12

COPILOT_LLM_NLU_ENABLED=false
